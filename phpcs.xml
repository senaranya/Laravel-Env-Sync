<?xml version="1.0"?>
<ruleset name="LaravelEnvSync">
    <description>Coding style for Laravel Env Sync</description>

    <file>src</file>
    <file>tests</file>

    <arg value="p"/> <!-- Show progress -->
    <arg value="s"/> <!-- Show sniff codes in violation messages -->
    <arg name="colors"/>

    <!-- Use PER-CS2.0 (or PSR12 as a fallback) -->
    <rule ref="PER-CS2.0"/>
</ruleset>
