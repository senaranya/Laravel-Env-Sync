<?xml version="1.0"?>
<ruleset name="LaravelEnvSync">
    <description>Coding style for Laravel Env Sync</description>

    <file>src</file>
    <file>tests</file>

    <arg value="p"/> <!-- Show progress -->
    <arg value="s"/> <!-- Show sniff codes in violation messages -->
    <arg name="colors"/>

    <rule ref="PSR12"/>
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
